# ── Legacy flat-file data — sudah diganti PostgreSQL (Prisma) ────────────────
# Folder ini sudah tidak dipakai untuk persistent storage.
# Data kini disimpan di database via Prisma (lihat prisma/schema.prisma).
# Tetap di-ignore agar file JSON lama tidak masuk ke repo.
data/

# ── Server logs ───────────────────────────────────────────────────────────────
logs/

# ── Dependencies & build artifacts ───────────────────────────────────────────
node_modules/

# ── Environment secrets ───────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ── Deploy temp dirs ──────────────────────────────────────────────────────────
.deploy_protect_*

# ── Uploaded / pasted assets (may contain sensitive content) ─────────────────
attached_assets/

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo

/src/generated/prisma
