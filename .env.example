# Copy this file to .env and fill in real values before deploying
# In cPanel: set these under "Node.js App" > "Environment Variables"

# Node environment (set to "production" on live server)
NODE_ENV=production

# Admin bootstrap credentials — used only when the database has no AdminCredential row
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password_here

# Web Push notifications — generate a matching public/private pair with:
# npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:smkn1wonogiri@gmail.com

# Port (cPanel/Passenger sets this automatically — do not change unless self-hosting)
# PORT=3000
