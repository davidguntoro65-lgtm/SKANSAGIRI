# Copy this file to .env and fill in real values before deploying
# In cPanel: set these under "Node.js App" > "Environment Variables"

# Node environment (set to "production" on live server)
NODE_ENV=production

# Maximum PostgreSQL connections per Node worker (default 10).
# Keep this within your database/provider connection quota.
DATABASE_POOL_MAX=10

# Admin bootstrap credentials — used only when the database has no AdminCredential row
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_strong_password_here

# Web Push notifications — generate a matching public/private pair with:
# npx web-push generate-vapid-keys --json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:smkn1wonogiri@gmail.com

# Optional Google OAuth for the admin "Hubungkan Google Drive" popup.
# Create a Web OAuth client in Google Cloud and register the exact callback URL.
# cPanel's callback path includes the deployment base path (/id).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/id/api/v1/diklat/admin/drive/oauth/callback

# Port (cPanel/Passenger sets this automatically — do not change unless self-hosting)
# PORT=3000
