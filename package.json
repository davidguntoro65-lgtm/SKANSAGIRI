{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "npx --yes tsx server.ts",
    "build": "vite build && npx prisma generate && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:fsevents --sourcemap --outfile=dist/server.cjs",
    "build:cpanel": "VITE_BASE_PATH=/id/ npm run build",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "postinstall": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "db:seed": "npx tsx scripts/seed-from-json.ts",
    "db:seed:pilketos": "npx tsx scripts/seed-pilketos-demo.ts"
  },
  "dependencies": {
    "@google/genai": "^2.24.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.2.0",
    "core-js": "^3.50.0",
    "dotenv": "^17.4.2",
    "drizzle-zod": "^0.8.3",
    "express": "^4.22.3",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "p-limit": "^7.3.3",
    "p-retry": "^7.1.1",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.5",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.4",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.12",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
