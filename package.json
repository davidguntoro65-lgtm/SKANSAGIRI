{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "dist/server.cjs",
  "scripts": {
    "dev": "npx --yes tsx server.ts",
    "build": "vite build && npx prisma generate && esbuild server.ts --bundle --platform=node --format=cjs --external:vite --external:fsevents --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "postinstall": "npx prisma generate",
    "db:migrate": "npx prisma migrate deploy",
    "db:studio": "npx prisma studio",
    "db:seed": "npx tsx scripts/seed-from-json.ts"
  },
  "dependencies": {
    "@google/genai": "^2.9.0",
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/pg": "^8.20.0",
    "@vitejs/plugin-react": "^5.2.0",
    "core-js": "^3.49.0",
    "dotenv": "^17.4.2",
    "drizzle-zod": "^0.8.3",
    "express": "^4.22.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "motion": "^12.40.0",
    "p-limit": "^7.3.0",
    "p-retry": "^7.1.1",
    "pg": "^8.22.0",
    "prisma": "^7.9.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zod-validation-error": "^5.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.21",
    "autoprefixer": "^10.5.0",
    "esbuild": "^0.25.12",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
