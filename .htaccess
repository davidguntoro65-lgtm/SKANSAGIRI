# ─── 1. REWRITE ENGINE ───────────────────────────────────────────────────────
# LiteSpeed + cPanel Node.js Selector (NO Passenger/Apache)
# Static assets are served directly by LiteSpeed for performance.
# API routes (/id/api/*) are passed to LiteSpeed's Node.js proxy (cPanel Selector).
# SPA routes are caught by the catch-all and served as dist/index.html.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /id/

    # [A] Root request → dist/index.html
    RewriteRule ^$ dist/index.html [L]
    RewriteRule ^index\.html$ dist/index.html [L]

    # [B] Built JS/CSS assets → dist/assets/ (served directly for speed)
    RewriteRule ^assets/(.+)$ dist/assets/$1 [L]

    # [C] PWA / static files
    RewriteRule ^manifest\.json$ dist/manifest.json [L]
    RewriteRule ^favicon\.svg$ dist/favicon.svg [L]
    RewriteRule ^favicon\.ico$ dist/favicon.ico [L]
    RewriteRule ^sw\.js$ dist/sw.js [L]
    RewriteRule ^robots\.txt$ dist/robots.txt [L]
    RewriteRule ^icons/(.+)$ dist/icons/$1 [L]
    RewriteRule ^og-image\.svg$ dist/og-image.svg [L]
    RewriteRule ^sitemap\.xml$ sitemap.xml [L]

    # [D] API routes — pass through to Node.js proxy WITHOUT serving as static files.
    # CRITICAL: These rules MUST come before rule [E] (physical file check).
    # Without this, LiteSpeed maps REQUEST_FILENAME to app.js for all /id/* requests,
    # causing rule [E] to serve app.js as raw JS instead of routing to the Node.js app.
    # Two separate rules (not [OR]) for maximum LiteSpeed compatibility.
    RewriteCond %{REQUEST_URI} ^/id/api/ [NC]
    RewriteRule .* - [L]
    RewriteCond %{REQUEST_URI} ^/api/ [NC]
    RewriteRule .* - [L]

    # [E] Real physical files → serve as-is (but only after API passthrough above)
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # [F] SPA catch-all — serve dist/index.html for all remaining (non-API) routes
    RewriteRule ^ dist/index.html [L]
</IfModule>

# ─── 2. SECURITY ─────────────────────────────────────────────────────────────
<FilesMatch "\.(env|ts|tsx|md|lock|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteRule ^src/.*$ - [F,L]
    RewriteRule ^data/.*$ - [F,L]
    RewriteRule ^app\.js$ - [F,L]
</IfModule>

# ─── 3. EXPLICIT MIME TYPES ──────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
</IfModule>

# ─── 4. COMPRESSION ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ─── 5. CACHE ────────────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
