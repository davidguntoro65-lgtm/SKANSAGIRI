# ─── 1. CONFIG ENGINE PASSENGER ──────────────────────────────────────────────
# Semua request di bawah /id/ diserahkan ke Node.js (Express).
# Express yang menangani: static dist/, API /api/, dan SPA fallback.
PassengerEnabled On
PassengerAppType node
PassengerStartupFile app.js

# KUNCI UTAMA: /id (bukan /id/api) agar Passenger menangani SEMUA request,
# bukan hanya API. Jika hanya /id/api, Apache akan serve index.html versi DEV
# (berisi <script src="/src/main.tsx">) dan frontend tidak bisa tampil.
PassengerBaseURI /id

# ─── 2. REWRITE ENGINE ───────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /id/

    # Blokir akses langsung ke file sensitif (berlapis dengan FilesMatch di bawah)
    RewriteRule ^data/.*$ - [F,L]
    RewriteRule ^src/.*$ - [F,L]
</IfModule>

# ─── 3. EXPLICIT MIME TYPES ──────────────────────────────────────────────────
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
</IfModule>

# ─── 4. SECURITY ─────────────────────────────────────────────────────────────
<FilesMatch "\.(env|ts|tsx|md|lock|log)$">
    Require all denied
</FilesMatch>

# ─── 5. COMPRESSION ──────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ─── 6. CACHE ASSETS ─────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
