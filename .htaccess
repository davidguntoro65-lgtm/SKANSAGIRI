# ─── 1. CONFIG ENGINE PASSENGER & API ENDPOINT ──────────────────────────────
# Mengaktifkan engine Node.js khusus untuk subfolder mading
PassengerEnabled On
PassengerAppType node
PassengerStartupFile app.js

# Kuncian Sakti: Daftarkan jalur /api secara eksplisit ke Passenger
PassengerBaseURI /id/api

# ─── 2. REWRITE ENGINE (SUTRADARA TRAFIK WEB) ────────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /id/
    DirectoryIndex index.html

    # [A] UTAMA: Jika request menuju ke /id/api/..., SERAHKAN LANGSUNG KE BACKEND (app.js)
    RewriteCond %{REQUEST_URI} ^/id/api [NC]
    RewriteRule ^(.*)$ app.js [L]

    # [B] Amankan file fisik asli (.js, .css, gambar) jika memang ada di dalam folder
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.*)$ - [L]

    # [C] Jembatan Aset: Alihkan request aset bawaan Vite ke folder build fisik (dist)
    RewriteRule ^assets/(.*)$ dist/assets/$1 [L]
    RewriteRule ^manifest\.json$ dist/manifest.json [L]
    RewriteRule ^favicon\.ico$ dist/favicon.ico [L]

    # [D] SPA Fallback Routing: Jika rute halaman React hancur/di-refresh (misal: /adm-panel)
    RewriteRule ^index\.html$ - [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule . /id/index.html [L]
</IfModule>

# ─── 3. EXPLICIT MIME TYPES (ANTI-PEMBLOKIRAN BROWSER) ───────────────────────
<IfModule mod_mime.c>
    AddType application/javascript .js
    AddType application/javascript .mjs
    AddType text/css .css
    AddType application/json .json
    AddType image/svg+xml .svg
    AddType application/manifest+json .webmanifest
</IfModule>

# ─── 4. SECURITY (BLOKIR AKSES SUMBER MENTAH) ────────────────────────────────
<FilesMatch "\.(env|ts|tsx|md|lock|log)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/.*$ - [F,L]
    RewriteRule ^src/.*$ - [F,L]
</IfModule>

# ─── 5. COMPRESSION (GASS SPEED WEBSITE) ─────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ─── 6. CACHE ASSETS ─────────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
