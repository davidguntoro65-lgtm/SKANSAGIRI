# ─── Phusion Passenger (cPanel Node.js Selector) ─────────────────────────────
# cPanel manages Passenger via the Node.js Selector UI.
# Startup file must match what is set in cPanel → Node.js Selector (app.js).
PassengerEnabled On
PassengerAppType node
PassengerStartupFile app.js

# ─── Explicit MIME types (critical for ES module scripts) ─────────────────────
# Without this, some cPanel/Apache configs serve .js as text/html → blank page.
AddType application/javascript .js
AddType application/javascript .mjs
AddType text/css .css
AddType application/json .json
AddType image/svg+xml .svg
AddType application/manifest+json .webmanifest

# ─── Security: block direct access to source / config files ──────────────────
<FilesMatch "\.(env|ts|tsx|md|lock|log)$">
    Require all denied
</FilesMatch>

# Block direct access to the raw data directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^data/.*$ - [F,L]
</IfModule>

# ─── Compression ─────────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# ─── Cache static assets ─────────────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
