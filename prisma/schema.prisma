// Prisma schema — SMKN 1 Wonogiri Portal
// Generator + datasource

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ── Key-value store: replaces all "replace-whole-collection" JSON files ────────
// Keys: competencies | milestones | gallery | alumni | news | partners |
//       branding | kepala-sekolah | manajemen-sekolah | visi-misi |
//       social-media | about
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Admin credentials ──────────────────────────────────────────────────────────
model AdminCredential {
  id       Int    @id @default(1)
  username String
  password String
}

// ── Session store (replaces sessions.json) ────────────────────────────────────
model Session {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Tracer study submissions ───────────────────────────────────────────────────
model TracerEntry {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
}

// ── Contact form messages ──────────────────────────────────────────────────────
model ContactMessage {
  id        String   @id @default(uuid())
  nama      String
  email     String
  noHp      String   @default("")
  keperluan String
  pesan     String
  waktu     DateTime @default(now())
  dibaca    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Aduan publik (complaints) ──────────────────────────────────────────────────
model AduanPublik {
  id          String   @id @default(uuid())
  namaLengkap String
  noHp        String   @default("")
  alamat      String   @default("")
  judul       String
  isi         String
  tanggal     String
  lokasi      String
  kategori    String
  anonim      Boolean  @default(false)
  rahasia     Boolean  @default(false)
  status      String   @default("BARU")
  catatan     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Suara Skansagiri: student works / articles ─────────────────────────────────
model KaryaSiswa {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  content       String
  excerpt       String
  category      String
  status        String          @default("REVIEW")
  feedback      String?
  views         Int             @default(0)
  likes         Int             @default(0)
  authorName    String
  authorClass   String
  authorJurusan String          @default("")
  tags          String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  publishedAt   DateTime?
  komentar      KomentarSuara[]
}

// ── Comments on student works ──────────────────────────────────────────────────
model KomentarSuara {
  id           String     @id @default(uuid())
  artikelId    String
  artikelTitle String
  authorName   String
  authorClass  String     @default("")
  content      String
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  karya        KaryaSiswa @relation(fields: [artikelId], references: [id], onDelete: Cascade)
}

// ══════════════════════════════════════════════════════════════════════════════
// ── OSIS "Skansagiri Student Parliament" ──────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// ── Kabinet info, visi misi OSIS ──────────────────────────────────────────────
model OsisInfo {
  id           Int      @id @default(1)
  namaKabinet  String   @default("OSIS SKANSAGIRI")
  masaBakti    String   @default("")
  tagline      String   @default("")
  visi         String   @default("")
  misi         String[] @default([])
  sejarah      String   @default("")
  quoteKetua   String   @default("")
  namaKetua    String   @default("")
  jumlahProker Int      @default(0)
  jumlahMember Int      @default(0)
  jumlahEkskul Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ── Pengurus OSIS ──────────────────────────────────────────────────────────────
model OsisPengurus {
  id         String   @id @default(uuid())
  nama       String
  jabatan    String
  bidang     String   @default("")
  foto       String?
  tugasPokok String   @default("")
  instagram  String   @default("")
  email      String   @default("")
  urutan     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ── Program Kerja OSIS ────────────────────────────────────────────────────────
model OsisProgramKerja {
  id              String   @id @default(uuid())
  nama            String
  bidang          String
  deskripsi       String   @default("")
  status          String   @default("DIRENCANAKAN") // DIRENCANAKAN | BERLANGSUNG | SELESAI
  progress        Int      @default(0) // 0-100
  targetDate      String   @default("")
  penanggungJawab String   @default("")
  urutan          Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ── Agenda / Event ────────────────────────────────────────────────────────────
model OsisAgenda {
  id        String   @id @default(uuid())
  nama      String
  tanggal   String
  waktu     String   @default("")
  tempat    String   @default("")
  deskripsi String   @default("")
  jenis     String   @default("RUTIN") // RUTIN | BESAR | KOLABORASI
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Ekstrakurikuler ───────────────────────────────────────────────────────────
model OsisEkskul {
  id            String   @id @default(uuid())
  nama          String
  kategori      String   @default("AKADEMIK") // AKADEMIK | SENI | OLAHRAGA | KEAGAMAAN | TEKNOLOGI
  deskripsi     String   @default("")
  jadwal        String   @default("")
  pembina       String   @default("")
  jumlahAnggota Int      @default(0)
  foto          String?
  urutan        Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ── Galeri Kegiatan OSIS ──────────────────────────────────────────────────────
model OsisGaleri {
  id        String   @id @default(uuid())
  judul     String
  kategori  String   @default("KEGIATAN")
  foto      String // base64 or URL
  createdAt DateTime @default(now())
}

// ── Prestasi OSIS & Ekskul ────────────────────────────────────────────────────
model OsisPrestasi {
  id        String   @id @default(uuid())
  judul     String
  deskripsi String   @default("")
  tingkat   String   @default("SEKOLAH") // SEKOLAH | KECAMATAN | KABUPATEN | PROVINSI | NASIONAL
  tanggal   String
  foto      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Aspirasi Siswa ─────────────────────────────────────────────────────────────
model OsisAspirasi {
  id        String   @id @default(uuid())
  nama      String   @default("Anonim")
  kelas     String   @default("")
  kategori  String   @default("KEGIATAN") // FASILITAS | KEGIATAN | KEBIJAKAN | SARAN
  isi       String
  anonim    Boolean  @default(false)
  status    String   @default("BARU") // BARU | DITINJAU | DIJAWAB
  balasan   String   @default("")
  publik    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ══════════════════════════════════════════════════════════════════════════════
// ── Core Platform: identity and academic master data ─────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

enum CoreUserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum CoreRoleName {
  ADMIN
  OPERATOR
  GURU
  SISWA
  WALI_KELAS
  BENDAHARA
  KEPALA_SEKOLAH
  EDITOR_PUBLIC
}

enum CoreRecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AssignmentStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum AssignmentSource {
  ADMIN_IMPORT
  ADMIN_MANUAL
  TEACHER_REQUEST
}

enum TeacherRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  NEEDS_REVISION
}

enum ImportStatus {
  PREVIEWED
  COMMITTED
  FAILED
}

model CoreUser {
  id          String         @id @default(uuid())
  email       String         @unique
  fullName    String
  status      CoreUserStatus @default(INVITED)
  activatedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  roles       CoreUserRole[]
  teacher     CoreTeacher?
  student     CoreStudent?
  auditLogs   CoreAuditLog[]
}

model CoreRole {
  id        String         @id @default(uuid())
  name      CoreRoleName   @unique
  users     CoreUserRole[]
  createdAt DateTime       @default(now())
}

model CoreUserRole {
  userId    String
  roleId    String
  user      CoreUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      CoreRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, roleId])
}

model AcademicYear {
  id          String                    @id @default(uuid())
  code        String                    @unique
  name        String
  isActive    Boolean                   @default(false)
  status      CoreRecordStatus          @default(ACTIVE)
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  classes     AcademicClass[]
  assignments TeachingAssignment[]
  requests    TeacherSelectionRequest[]
  enrollments StudentEnrollment[]
}

model Department {
  id        String           @id @default(uuid())
  code      String           @unique
  name      String
  status    CoreRecordStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  subjects  Subject[]
  classes   AcademicClass[]
}

model Subject {
  id            String                 @id @default(uuid())
  code          String                 @unique
  name          String
  departmentId  String?
  status        CoreRecordStatus       @default(ACTIVE)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  department    Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  assignments   TeachingAssignment[]
  teacherSkills TeacherSubject[]
  requestItems  TeacherSelectionItem[]
}

model AcademicClass {
  id             String                 @id @default(uuid())
  code           String                 @unique
  name           String
  grade          String
  academicYearId String
  departmentId   String?
  homeroomId     String?
  status         CoreRecordStatus       @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id])
  department     Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  homeroom       CoreTeacher?           @relation("HomeroomClasses", fields: [homeroomId], references: [id], onDelete: SetNull)
  assignments    TeachingAssignment[]
  enrollments    StudentEnrollment[]
  requestItems   TeacherSelectionItem[]

  @@index([academicYearId, status])
}

model CoreTeacher {
  id                String                    @id @default(uuid())
  nip               String                    @unique
  fullName          String
  email             String?
  phone             String?
  status            CoreRecordStatus          @default(ACTIVE)
  userId            String?                   @unique
  user              CoreUser?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  subjects          TeacherSubject[]
  assignments       TeachingAssignment[]
  selectionRequests TeacherSelectionRequest[]
  homeroomClasses   AcademicClass[]           @relation("HomeroomClasses")
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model CoreStudent {
  id          String              @id @default(uuid())
  nisn        String              @unique
  fullName    String
  email       String?
  phone       String?
  gender      String?
  birthPlace  String?
  birthDate   DateTime?
  status      CoreRecordStatus    @default(ACTIVE)
  userId      String?             @unique
  user        CoreUser?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  enrollments StudentEnrollment[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model TeacherSubject {
  teacherId String
  subjectId String
  status    CoreRecordStatus @default(ACTIVE)
  source    AssignmentSource @default(ADMIN_IMPORT)
  teacher   CoreTeacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@id([teacherId, subjectId])
}

model TeachingAssignment {
  id             String           @id @default(uuid())
  teacherId      String
  subjectId      String
  classId        String
  academicYearId String
  status         AssignmentStatus @default(ACTIVE)
  source         AssignmentSource @default(ADMIN_MANUAL)
  approvedBy     String?
  approvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  teacher        CoreTeacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject        Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  academicClass  AcademicClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId, academicYearId])
  @@index([academicYearId, status])
}

model TeacherSelectionRequest {
  id             String                 @id @default(uuid())
  teacherId      String
  academicYearId String
  status         TeacherRequestStatus   @default(DRAFT)
  submittedAt    DateTime?
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  teacher        CoreTeacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  items          TeacherSelectionItem[]

  @@unique([teacherId, academicYearId])
}

model TeacherSelectionItem {
  id        String                  @id @default(uuid())
  requestId String
  subjectId String
  classId   String
  request   TeacherSelectionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  subject   Subject                 @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class     AcademicClass           @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([requestId, subjectId, classId])
}

model StudentEnrollment {
  id             String           @id @default(uuid())
  studentId      String
  classId        String
  academicYearId String
  status         CoreRecordStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  student        CoreStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicClass  AcademicClass    @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear   AcademicYear     @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([classId, academicYearId])
}

model CoreImportJob {
  id           String       @id @default(uuid())
  templateType String
  fileName     String
  fileChecksum String
  status       ImportStatus @default(PREVIEWED)
  totalRows    Int          @default(0)
  successRows  Int          @default(0)
  errorRows    Int          @default(0)
  errors       Json?
  uploadedBy   String
  createdAt    DateTime     @default(now())
  committedAt  DateTime?

  @@index([templateType, createdAt])
}

model CoreAuditLog {
  id        String    @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  actor     String
  metadata  Json?
  createdAt DateTime  @default(now())
  userId    String?
  user      CoreUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, createdAt])
}
