// Prisma schema — SMKN 1 Wonogiri Portal
// Generator + datasource

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ── Key-value store: replaces all "replace-whole-collection" JSON files ────────
// Keys: competencies | milestones | gallery | alumni | news | partners |
//       branding | kepala-sekolah | manajemen-sekolah | visi-misi |
//       social-media | about
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ── Admin credentials ──────────────────────────────────────────────────────────
model AdminCredential {
  id       Int    @id @default(1)
  username String
  password String
}

// ── Session store (replaces sessions.json) ────────────────────────────────────
model Session {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Tracer study submissions ───────────────────────────────────────────────────
model TracerEntry {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
}

// ── Contact form messages ──────────────────────────────────────────────────────
model ContactMessage {
  id        String   @id @default(uuid())
  nama      String
  email     String
  noHp      String   @default("")
  keperluan String
  pesan     String
  waktu     DateTime @default(now())
  dibaca    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ── Aduan publik (complaints) ──────────────────────────────────────────────────
model AduanPublik {
  id          String   @id @default(uuid())
  namaLengkap String
  noHp        String   @default("")
  alamat      String   @default("")
  judul       String
  isi         String
  tanggal     String
  lokasi      String
  kategori    String
  anonim      Boolean  @default(false)
  rahasia     Boolean  @default(false)
  status      String   @default("BARU")
  catatan     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Suara Skansagiri: student works / articles ─────────────────────────────────
model KaryaSiswa {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  content       String
  excerpt       String
  category      String
  status        String          @default("REVIEW")
  feedback      String?
  views         Int             @default(0)
  likes         Int             @default(0)
  authorName    String
  authorClass   String
  authorJurusan String          @default("")
  tags          String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  publishedAt   DateTime?
  komentar      KomentarSuara[]
}

// ── Comments on student works ──────────────────────────────────────────────────
model KomentarSuara {
  id           String     @id @default(uuid())
  artikelId    String
  artikelTitle String
  authorName   String
  authorClass  String     @default("")
  content      String
  status       String     @default("PENDING")
  createdAt    DateTime   @default(now())
  karya        KaryaSiswa @relation(fields: [artikelId], references: [id], onDelete: Cascade)
}

// ══════════════════════════════════════════════════════════════════════════════
// ── OSIS "Skansagiri Student Parliament" ──────────────────────────────────────
// ══════════════════════════════════════════════════════════════════════════════

// ── Kabinet info, visi misi OSIS ──────────────────────────────────────────────
model OsisInfo {
  id           Int      @id @default(1)
  namaKabinet  String   @default("OSIS SKANSAGIRI")
  masaBakti    String   @default("")
  tagline      String   @default("")
  visi         String   @default("")
  misi         String[] @default([])
  sejarah      String   @default("")
  quoteKetua   String   @default("")
  namaKetua    String   @default("")
  jumlahProker Int      @default(0)
  jumlahMember Int      @default(0)
  jumlahEkskul Int      @default(0)
  updatedAt    DateTime @updatedAt
}

// ── Pengurus OSIS ──────────────────────────────────────────────────────────────
model OsisPengurus {
  id          String   @id @default(uuid())
  nama        String
  jabatan     String
  bidang      String   @default("")
  foto        String?
  tugasPokok  String   @default("")
  instagram   String   @default("")
  email       String   @default("")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Program Kerja OSIS ────────────────────────────────────────────────────────
model OsisProgramKerja {
  id          String   @id @default(uuid())
  nama        String
  bidang      String
  deskripsi   String   @default("")
  status      String   @default("DIRENCANAKAN") // DIRENCANAKAN | BERLANGSUNG | SELESAI
  progress    Int      @default(0)  // 0-100
  targetDate  String   @default("")
  penanggungJawab String @default("")
  urutan      Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Agenda / Event ────────────────────────────────────────────────────────────
model OsisAgenda {
  id          String   @id @default(uuid())
  nama        String
  tanggal     String
  waktu       String   @default("")
  tempat      String   @default("")
  deskripsi   String   @default("")
  jenis       String   @default("RUTIN") // RUTIN | BESAR | KOLABORASI
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Ekstrakurikuler ───────────────────────────────────────────────────────────
model OsisEkskul {
  id           String   @id @default(uuid())
  nama         String
  kategori     String   @default("AKADEMIK") // AKADEMIK | SENI | OLAHRAGA | KEAGAMAAN | TEKNOLOGI
  deskripsi    String   @default("")
  jadwal       String   @default("")
  pembina      String   @default("")
  jumlahAnggota Int     @default(0)
  foto         String?
  urutan       Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ── Galeri Kegiatan OSIS ──────────────────────────────────────────────────────
model OsisGaleri {
  id        String   @id @default(uuid())
  judul     String
  kategori  String   @default("KEGIATAN")
  foto      String   // base64 or URL
  createdAt DateTime @default(now())
}

// ── Prestasi OSIS & Ekskul ────────────────────────────────────────────────────
model OsisPrestasi {
  id        String   @id @default(uuid())
  judul     String
  deskripsi String   @default("")
  tingkat   String   @default("SEKOLAH") // SEKOLAH | KECAMATAN | KABUPATEN | PROVINSI | NASIONAL
  tanggal   String
  foto      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Aspirasi Siswa ─────────────────────────────────────────────────────────────
model OsisAspirasi {
  id        String   @id @default(uuid())
  nama      String   @default("Anonim")
  kelas     String   @default("")
  kategori  String   @default("KEGIATAN") // FASILITAS | KEGIATAN | KEBIJAKAN | SARAN
  isi       String
  anonim    Boolean  @default(false)
  status    String   @default("BARU") // BARU | DITINJAU | DIJAWAB
  balasan   String   @default("")
  publik    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
