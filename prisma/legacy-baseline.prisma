// Baseline contract for databases created before Prisma Migrate was introduced.
// This intentionally mirrors only the first migration. It is used by deploy.sh
// to verify the legacy production schema before marking that migration applied.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model AdminCredential {
  id       Int    @id @default(1)
  username String
  password String
}

model Session {
  token     String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model TracerEntry {
  id        String   @id
  data      Json
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  nama      String
  email     String
  noHp      String   @default("")
  keperluan String
  pesan     String
  waktu     DateTime @default(now())
  dibaca    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AduanPublik {
  id          String   @id @default(uuid())
  namaLengkap String
  noHp        String   @default("")
  alamat      String   @default("")
  judul       String
  isi         String
  tanggal     String
  lokasi      String
  kategori    String
  anonim      Boolean  @default(false)
  rahasia     Boolean  @default(false)
  status      String   @default("BARU")
  catatan     String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model KaryaSiswa {
  id            String          @id @default(uuid())
  title         String
  slug          String          @unique
  content       String
  excerpt       String
  category      String
  status        String          @default("REVIEW")
  feedback      String?
  views         Int             @default(0)
  likes         Int             @default(0)
  authorName    String
  authorClass   String
  authorJurusan String          @default("")
  tags          String[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  publishedAt   DateTime?
  komentar      KomentarSuara[]
}

model KomentarSuara {
  id           String      @id @default(uuid())
  artikelId    String
  artikelTitle String
  authorName   String
  authorClass  String      @default("")
  content      String
  status       String      @default("PENDING")
  createdAt    DateTime    @default(now())
  karya        KaryaSiswa @relation(fields: [artikelId], references: [id], onDelete: Cascade)
}